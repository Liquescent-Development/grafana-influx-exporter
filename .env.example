# Grafana InfluxDB Exporter Environment Variables
# Copy this file to .env and fill in your values

# Grafana Authentication (choose one method)
# Method 1: Service Account Token (Recommended)
GRAFANA_TOKEN=your-service-account-token-here

# Method 2: Basic Authentication
# GRAFANA_USERNAME=your-grafana-username
# GRAFANA_PASSWORD=your-grafana-password

# Optional Configuration Overrides
CONFIG_PATH=/app/config.yaml
LOG_LEVEL=info
METRICS_PORT=8080

# Docker Compose specific variables
COMPOSE_PROJECT_NAME=grafana-influx-exporter

# Development variables
GRAFANA_URL=http://localhost:3000
INFLUXDB_DATASOURCE_UID=your-influxdb-datasource-uid